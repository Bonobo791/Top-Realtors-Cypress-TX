---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy | Top Realtors Cypress TX"
  description="Privacy practices for this editorial directory and its outbound links."
  path="/privacy.html"
>
  <main id="main" class="wrap legal">
    <span class="eyebrow">Privacy</span>
    <h1>Read without signing up.</h1>
    <p>
      This build has no accounts, lead forms, visitor reviews, analytics scripts
      or advertising trackers. It does not collect or forward inquiries.
    </p>
    <h2>Outbound websites</h2>
    <p>
      Following a professional or source link takes you to another website,
      which has its own privacy practices.
    </p>
    <h2>Technical requests</h2>
    <p>
      Your browser requests page files from the selected host. Hosting logs and
      retention depend on the hosting provider and must be confirmed before
      launch. Fonts use local system fallbacks; no third-party font request is
      made by this build.
    </p>
  </main>
</Base>
